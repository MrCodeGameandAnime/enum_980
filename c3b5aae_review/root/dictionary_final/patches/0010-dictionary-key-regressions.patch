--- /dev/null
+++ b/tests/basics/dict_string_subclass_keys.py
@@ -0,0 +1,221 @@
+"""Dictionary string-subclass keys, including interned-string map shortcuts."""
+
+import json
+from collections import OrderedDict
+
+
+def check(value, message):
+    if not value:
+        raise AssertionError(message)
+
+
+def rejected(error, operation):
+    try:
+        operation()
+    except error:
+        return
+    raise AssertionError("expected " + error.__name__)
+
+
+class Text(str):
+    pass
+
+
+class Child(Text):
+    pass
+
+
+class Alias:
+    def __hash__(self):
+        return hash("fast")
+
+    def __eq__(self, other):
+        return other == "fast"
+
+
+def reads():
+    for key in (Text("fast"), Child("fast"), Alias()):
+        data = {"fast": 1}
+        check(data[key] == 1, "lookup equivalent key")
+        check(data.get(key) == 1 and key in data, "get/containment")
+        check(data["fast"] == 1, "raw key still accessible")
+
+
+def assignment():
+    for key in (Text("fast"), Child("fast"), Alias()):
+        data = {"fast": 1}
+        original = next(iter(data))
+        data[key] = 2
+        check(len(data) == 1 and data["fast"] == 2, "replace equal key")
+        check(next(iter(data)) is original, "preserve originally stored key")
+
+
+def reverse():
+    for key in (Text("fast"), Alias()):
+        data = {key: 1}
+        check(data["fast"] == 1 and "fast" in data, "reverse lookup")
+        data["fast"] = 2
+        check(len(data) == 1 and next(iter(data)) is key, "reverse replacement")
+
+
+def deletion():
+    for key in (Text("fast"), Alias()):
+        data = {"fast": 1}
+        del data[key]
+        check(len(data) == 0, "delete equal key")
+        rejected(KeyError, lambda: data[key])
+
+
+def pop():
+    for key in (Text("fast"), Alias()):
+        data = {"fast": 1}
+        check(data.pop(key) == 1 and not data, "pop equal key")
+        check(data.pop(key, 3) == 3, "missing pop default")
+        rejected(KeyError, lambda: data.pop(key))
+
+
+def setdefault():
+    for key in (Text("fast"), Alias()):
+        data = {"fast": 1}
+        check(data.setdefault(key, 2) == 1 and len(data) == 1, "existing setdefault")
+        data = {}
+        check(data.setdefault(key, 2) == 2 and data["fast"] == 2, "new setdefault")
+
+
+def update():
+    for key in (Text("fast"), Alias()):
+        for pairs in ({key: 2}, [(key, 2)]):
+            data = {"fast": 1}
+            data.update(pairs)
+            check(len(data) == 1 and data["fast"] == 2, "update equal key")
+
+
+def fromkeys():
+    for key in (Text("fast"), Alias()):
+        data = dict.fromkeys(["fast", key], 3)
+        check(len(data) == 1 and data["fast"] == 3, "fromkeys deduplication")
+        data = {item: 3 for item in ["fast", key]}  # noqa: C420 - exercise comprehension
+        check(len(data) == 1, "comprehension deduplication")
+
+
+def growth():
+    data = {"fast": 1}
+    for i in range(64):
+        data["key%d" % i] = i
+    check(data[Text("fast")] == 1, "lookup after growth")
+    for i in range(64):
+        del data["key%d" % i]
+    data[Text("fast")] = 2
+    check(len(data) == 1 and data["fast"] == 2, "replacement after growth/deletion")
+
+
+def layouts():
+    for key in (Text("fast"), Alias()):
+        data = {"fast": 1, 0: 2}
+        check(data[key] == 1, "mixed map")
+        del data[0]
+        check(data[key] == 1, "formerly mixed map")
+        raw = "".join(chr(97 + i % 26) for i in range(173))
+        data = {raw: 4}
+        check(data[Text(raw)] == 4, "non-interned string key")
+
+
+def readonly():
+    class Bag:
+        fast = 1
+
+    check(Bag.__dict__[Text("fast")] == 1, "class namespace lookup")
+    mapping = str.__dict__
+    check(mapping[Text("strip")] is mapping["strip"], "native fixed map lookup")
+
+
+def ordered():
+    for key in (Text("fast"), Alias()):
+        data = OrderedDict([("fast", 1), ("slow", 2)])
+        check(data[key] == 1, "ordered lookup")
+        data[key] = 3
+        check(len(data) == 2 and list(data) == ["fast", "slow"], "ordered replacement")
+        check(data.pop(key) == 3 and list(data) == ["slow"], "ordered removal")
+
+
+def custom_equality():
+    class Reject(str):
+        def __eq__(self, other):
+            return False
+
+        def __hash__(self):
+            return hash("fast")
+
+    key = Reject("fast")
+    data = {"fast": 1}
+    check(key not in data, "respect custom false equality")
+    rejected(KeyError, lambda: data[key])
+    data[key] = 2
+    check(len(data) == 2, "do not normalize unequal subclass to str")
+
+    class Broken(str):
+        def __eq__(self, other):
+            raise ValueError("equality failed")
+
+        def __hash__(self):
+            return hash("fast")
+
+    rejected(ValueError, lambda: {"fast": 1}[Broken("fast")])
+
+
+def custom_hash():
+    calls = []
+
+    class Hashed(str):
+        def __hash__(self):
+            calls.append(1)
+            return hash("fast")
+
+    check({"fast": 1}[Hashed("fast")] == 1 and calls, "respect custom hash")
+
+
+def generic_equality():
+    key = Alias()
+    data = {"fast": 1}
+    check(key in data and data[key] == 1, "non-string equivalent object")
+    data[key] = 2
+    check(len(data) == 1 and type(next(iter(data))) is str, "generic equal key replacement")
+    rejected(KeyError, lambda: data[object()])
+    rejected(KeyError, lambda: data[123])
+
+
+def unhashable():
+    class Unhashable(str):
+        __hash__ = None
+
+    rejected(TypeError, lambda: {"fast": 1}[Unhashable("fast")])
+    rejected(TypeError, lambda: {"fast": 1}.get(Unhashable("fast")))
+
+
+TESTS = (
+    reads,
+    assignment,
+    reverse,
+    deletion,
+    pop,
+    setdefault,
+    update,
+    fromkeys,
+    growth,
+    layouts,
+    readonly,
+    ordered,
+    custom_equality,
+    custom_hash,
+    generic_equality,
+    unhashable,
+)
+failures = []
+for test in TESTS:
+    try:
+        test()
+    except Exception as error:
+        failures.append([test.__name__, type(error).__name__, str(error)])
+print(json.dumps({"checks": len(TESTS), "failures": failures}))
+if failures:
+    raise AssertionError("dictionary string-key regressions")
